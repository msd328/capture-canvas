# Capture Canvas SaaS server configuration.
#
# Copy only the values required for the environment you are running. Never commit a
# populated .env file. The Supabase secret key and payment-provider secrets belong only
# in the trusted SaaS server environment; they must not be embedded in Tauri, React,
# installers, screenshots, logs, or public CI output.

# Supabase project root URL. Production must use HTTPS. Local development may use the
# numeric loopback URL printed by `supabase start`.
RECORDER_SUPABASE_URL=

# Server-only Supabase secret/service-role credential. Do not use a publishable/anon key
# here and do not expose this value to the desktop application.
RECORDER_SUPABASE_SECRET_KEY=

# Verified access-token trust contract. For Supabase, the issuer normally ends in
# /auth/v1 on the same origin as RECORDER_SUPABASE_URL.
RECORDER_AUTH_ISSUER=
RECORDER_AUTH_AUDIENCE=

# Direct object-storage upload contract. Leave unset until the authenticated adapter is
# implemented. The upload origin must use HTTPS outside numeric-loopback development.
RECORDER_UPLOAD_ORIGIN=
RECORDER_UPLOAD_BUCKET=
RECORDER_MAX_UPLOAD_BYTES=

# Future billing secrets are intentionally not consumed by the application yet.
# Add them to the trusted server secret manager only when each provider adapter lands.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
